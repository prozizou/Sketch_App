<?xml version="1.0" encoding="utf-8"?>
<!-- All of the app's network traffic must use TLS. Add a <domain-config> here only for a host that truly needs plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
