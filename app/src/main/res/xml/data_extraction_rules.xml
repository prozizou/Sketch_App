<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules): same policy as backup_rules.xml for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="root" />
        <exclude domain="sharedpref" path="update_checker.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="FirebaseAppHeartBeat.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="root" />
        <exclude domain="sharedpref" path="update_checker.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="FirebaseAppHeartBeat.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
    </device-transfer>
</data-extraction-rules>
