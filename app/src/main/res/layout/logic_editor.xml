<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<RelativeLayout
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SketchwarePro.Toolbar.SmallText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:subtitle="@string/common_word_oncreate"
            app:title="@string/common_word_activity" />

        <LinearLayout
            android:id="@+id/editor_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.besome.sketch.editor.view.ViewLogicEditor
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="?attr/colorSurfaceContainerLow"
                android:forceDarkAllowed="false"
                tools:ignore="UnusedAttribute" />

            <!-- The Java of the blocks, in place of the canvas (toolbar action switches). It can be edited: the status row
                 says whether it matches the blocks, and "Apply to blocks" turns it into blocks after a review. -->
            <LinearLayout
                android:id="@+id/code_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="?attr/colorSurfaceContainerLowest"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Shown when the blocks changed while the Java holds edits that were not applied. -->
                <LinearLayout
                    android:id="@+id/code_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSecondaryContainer"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/code_banner_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingVertical="6dp"
                        android:text="@string/logic_sync_banner_blocks_changed"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/code_banner_action"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="@string/logic_sync_banner_show_new"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <io.github.rosemoe.sora.widget.CodeEditor
                        android:id="@+id/code_editor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/code_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="32dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:alpha="0.92"
                        android:background="@drawable/canvas_control_bg"
                        android:elevation="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="2dp">

                        <ImageButton
                            android:id="@+id/btn_code_copy"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/logic_code_copy"
                            android:padding="7dp"
                            android:src="@drawable/ic_mtrl_copy"
                            app:tint="?attr/colorOnSurface" />

                        <ImageButton
                            android:id="@+id/btn_code_maximize"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/logic_code_maximize"
                            android:padding="7dp"
                            android:src="@drawable/ic_focus_preview"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Status, undo and redo of applied Java, save, and the button that applies it to the blocks. -->
                <LinearLayout
                    android:id="@+id/code_bar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:id="@+id/code_status"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:background="?attr/selectableItemBackground"
                        android:drawablePadding="6dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        tools:text="Line 3: Missing ';'" />

                    <ImageButton
                        android:id="@+id/btn_code_undo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/logic_sync_undo"
                        android:padding="8dp"
                        android:src="@drawable/ic_mtrl_undo"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageButton
                        android:id="@+id/btn_code_redo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/logic_sync_redo"
                        android:padding="8dp"
                        android:src="@drawable/ic_mtrl_redo"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageButton
                        android:id="@+id/btn_code_save"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/logic_sync_save"
                        android:padding="8dp"
                        android:src="@drawable/ic_mtrl_save"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <Button
                        android:id="@+id/btn_code_apply"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/logic_sync_apply"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Never wider than the space beside the right drawer, so longer translations or a larger font can't push it
         under the drawer; it is placed at runtime by FloatingBarDragger. -->
    <LinearLayout
        android:id="@+id/canvas_controls"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_toStartOf="@+id/right_drawer"
        android:background="@drawable/canvas_control_bg"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/canvas_controls_handle"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/logic_canvas_controls_move"
            android:paddingHorizontal="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_drag_handle_dots_vertical"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tv_zoom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="40dp"
            android:text="100%"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_canvas_fit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="40dp"
            android:paddingHorizontal="10dp"
            android:text="@string/logic_canvas_fit"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.besome.sketch.editor.LogicEditorDrawer
        android:id="@+id/right_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:elevation="@dimen/logic_drawer_elevation"
        android:translationX="200dp" />

    <LinearLayout
        android:id="@+id/layout_palette"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The blocks button opens the blocks collection; the palette opens from the bottom tabs. -->
        <LinearLayout
            android:id="@+id/fab_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_toggle_palette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/action_button_margin"
                android:alpha="0.8"
                android:contentDescription="@string/common_word_blocks_collection"
                android:src="@drawable/block_flled_white"
                app:backgroundTint="?attr/colorSecondaryContainer"
                app:elevation="2dp"
                app:fabCustomSize="36dp"
                app:maxImageSize="18dp"
                app:fabSize="mini"
                app:pressedTranslationZ="4dp"
                app:tint="?attr/colorOnSecondaryContainer" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/area_palette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="16dp"
            android:orientation="horizontal">

            <com.besome.sketch.editor.logic.PaletteBlock
                android:id="@+id/palette_block"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

    <com.besome.sketch.editor.logic.LogicTopMenu
        android:id="@+id/top_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:translationY="-48dp" />

    <com.besome.sketch.editor.view.ViewDummy
        android:id="@+id/dummy"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        app:itemBackground="@drawable/bg_logic_nav_item"
        app:itemIconSize="20dp"
        app:itemPaddingBottom="3dp"
        app:itemPaddingTop="3dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/logic_bottom_nav"
        style="@style/Widget.SketchwarePro.BottomNavigationView.Compact" />
</LinearLayout>
