<?xml version="1.0" encoding="utf-8"?>
<!-- Edit Block: General, Parameters, Spec and Code tabs over a fixed Cancel / Save bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/abc_action_bar_up_description"
            app:navigationIcon="?attr/homeAsUpIndicator" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabMode="auto">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/be_tab_general" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/be_tab_parameters" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/be_tab_spec" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/be_tab_code" />
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <!-- General -->
                <LinearLayout
                    android:id="@+id/page_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/preview_card"
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/be_preview"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorPrimary" />

                                <ImageButton
                                    android:id="@+id/zoom_out"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/be_zoom_out"
                                    android:src="@drawable/ic_mtrl_minus"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/zoom_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackground"
                                    android:contentDescription="@string/be_zoom_fit"
                                    android:gravity="center"
                                    android:minWidth="48dp"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorOnSurface" />

                                <ImageButton
                                    android:id="@+id/zoom_in"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/be_zoom_in"
                                    android:src="@drawable/ic_mtrl_add"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <HorizontalScrollView
                                android:id="@+id/preview_scroll"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="72dp"
                                android:scrollbars="none">

                                <FrameLayout
                                    android:id="@+id/preview_holder"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minHeight="72dp"
                                    android:padding="12dp">

                                    <LinearLayout
                                        android:id="@+id/block_area"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical" />
                                </FrameLayout>
                            </HorizontalScrollView>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <pro.sketchware.blocks.editor.CollapsibleSection
                        android:id="@+id/section_basics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:sectionTitle="@string/be_section_basics">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/name_layout"
                            style="?attr/textInputOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/be_name_hint"
                            app:helperText="@string/be_name_helper">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/be_shape_label"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:clipToPadding="false"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/type_shapes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp" />
                        </HorizontalScrollView>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/typename_layout"
                            style="?attr/textInputOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/be_typename_hint"
                            android:visibility="gone"
                            app:helperText="@string/be_typename_helper">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/typename"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </pro.sketchware.blocks.editor.CollapsibleSection>

                    <pro.sketchware.blocks.editor.CollapsibleSection
                        android:id="@+id/section_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:sectionTitle="@string/be_section_color">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/color_swatch"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="12dp"
                                android:background="@drawable/bg_block_palette_swatch" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/colour_layout"
                                style="?attr/textInputOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/be_color_hint">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/colour"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textNoSuggestions"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <ImageButton
                                android:id="@+id/openColorPalette"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/be_color_pick"
                                android:src="@drawable/ic_mtrl_palette"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <ImageButton
                                android:id="@+id/reset"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/be_color_reset"
                                android:src="@drawable/ic_mtrl_undo"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/be_color_presets"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/color_presets"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </pro.sketchware.blocks.editor.CollapsibleSection>

                    <pro.sketchware.blocks.editor.CollapsibleSection
                        android:id="@+id/section_templates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:sectionExpanded="false"
                        app:sectionTitle="@string/be_section_templates">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/be_templates_hint"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/template_chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </pro.sketchware.blocks.editor.CollapsibleSection>
                </LinearLayout>

                <!-- Parameters -->
                <LinearLayout
                    android:id="@+id/page_parameters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/be_params_intro"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_param"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/be_params_add"
                        app:icon="@drawable/ic_mtrl_add" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/params_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/params_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/be_params_empty"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/params_issues"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Spec -->
                <LinearLayout
                    android:id="@+id/page_spec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:scrollbars="none">

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="72dp"
                                android:padding="12dp">

                                <LinearLayout
                                    android:id="@+id/block_area_spec"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </FrameLayout>
                        </HorizontalScrollView>
                    </com.google.android.material.card.MaterialCardView>

                    <pro.sketchware.blocks.editor.CollapsibleSection
                        android:id="@+id/section_spec_builder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:sectionTitle="@string/be_section_spec_builder">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/spec_chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/spec_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/be_spec_empty"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/spec_add_text"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:minHeight="48dp"
                                android:text="@string/be_spec_add_text" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/spec_add_param"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/be_spec_add_param" />
                        </LinearLayout>
                    </pro.sketchware.blocks.editor.CollapsibleSection>

                    <pro.sketchware.blocks.editor.CollapsibleSection
                        android:id="@+id/section_spec_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:sectionTitle="@string/be_section_spec_text">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/spec_layout"
                            style="?attr/textInputOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/be_spec_hint"
                            app:helperText="@string/be_spec_helper">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/spec"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top"
                                android:inputType="textMultiLine|textNoSuggestions"
                                android:minLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/spec2_layout"
                            style="?attr/textInputOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/be_spec2_hint"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/spec2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/spec_issues"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorError"
                            android:visibility="gone" />
                    </pro.sketchware.blocks.editor.CollapsibleSection>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Code -->
        <LinearLayout
            android:id="@+id/page_code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <pro.sketchware.blocks.editor.CollapsibleSection
                android:id="@+id/section_imports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionExpanded="false"
                app:sectionTitle="@string/be_imports_title">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/be_imports_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/imports_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/import_layout"
                        style="?attr/textInputOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/be_import_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/import_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textNoSuggestions|textUri"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/import_add"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="48dp"
                        android:text="@string/be_import_add" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/import_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </pro.sketchware.blocks.editor.CollapsibleSection>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/be_code_hint"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/code_undo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/be_undo"
                    android:src="@drawable/ic_mtrl_undo"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/code_redo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/be_redo"
                    android:src="@drawable/ic_mtrl_redo"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/code_search_toggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/be_code_search"
                    android:src="@drawable/ic_mtrl_search"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/code_search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/code_search_query"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="@string/be_code_search_hint"
                    android:importantForAutofill="no"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/code_search_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/code_search_previous"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/be_code_search_previous"
                    android:src="@drawable/ic_mtrl_arrow_up"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/code_search_next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/be_code_search_next"
                    android:src="@drawable/ic_mtrl_arrow_down"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/code_search_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/be_code_search_close"
                    android:src="@drawable/ic_mtrl_close"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <io.github.rosemoe.sora.widget.CodeEditor
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="160dp" />

            <pro.sketchware.blocks.editor.CollapsibleSection
                android:id="@+id/section_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionTitle="@string/be_diagnostics">

                <ScrollView
                    android:id="@+id/diagnostics_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/diagnostics_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </pro.sketchware.blocks.editor.CollapsibleSection>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/common_word_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            style="?attr/materialButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/be_save_block" />
    </LinearLayout>
</LinearLayout>
