<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layout_palette"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/palette_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <EditText
            android:id="@+id/search_widgets"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/palette_search_bg"
            android:drawableStart="@drawable/ic_search_palette"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:hint="@string/view_search_widgets"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.besome.sketch.editor.view.palette.PaletteWidget
                android:id="@+id/palette_widget"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.besome.sketch.editor.view.palette.PaletteFavorite
                android:id="@+id/palette_favorite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/palette_resize_handle"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_marginStart="-10dp"
        android:layout_toEndOf="@+id/layout_palette"
        android:contentDescription="@string/view_palette_resize"
        android:elevation="2dp">

        <View
            android:layout_width="4dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_resize_grabber" />
    </FrameLayout>

    <com.besome.sketch.editor.view.DotGridFrameLayout
        android:id="@+id/shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/layout_palette"
        android:background="?attr/colorSurfaceContainer"
        android:forceDarkAllowed="false"
        tools:ignore="UnusedAttribute" />


    <com.besome.sketch.editor.view.ViewDummy
        android:id="@+id/dummy"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <com.besome.sketch.editor.view.ViewProperties
        android:id="@+id/properties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:translationY="150dp" />

    <LinearLayout
        android:id="@+id/workspace_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/palette_search_bg"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_toggle_palette"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/view_workspace_toggle_widgets"
            android:src="@drawable/ic_panel_left" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/zoom_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            app:selectionRequired="false"
            app:singleSelection="true">

            <Button
                android:id="@+id/zoom_fit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/view_zoom_fit"
                android:textSize="12sp" />

            <Button
                android:id="@+id/zoom_50"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/view_zoom_50"
                android:textSize="12sp" />

            <Button
                android:id="@+id/zoom_75"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/view_zoom_75"
                android:textSize="12sp" />

            <Button
                android:id="@+id/zoom_100"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/view_zoom_100"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <ImageButton
            android:id="@+id/btn_toggle_properties"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/view_workspace_toggle_properties"
            android:src="@drawable/ic_panel_right" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/delete_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:animateLayoutChanges="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:translationY="106dp"
        app:cardBackgroundColor="?colorSurfaceContainerHighest"
        app:cardCornerRadius="18dp"
        app:strokeWidth="1dp"
        tools:translationY="-20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_delete"
                android:layout_width="30dp"
                android:layout_height="50dp"
                android:contentDescription="@null"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mtrl_delete"
                app:tint="?colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/text_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Drag here to delete"
                android:textColor="?colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
