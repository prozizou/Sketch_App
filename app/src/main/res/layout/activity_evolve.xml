<?xml version="1.0" encoding="utf-8"?>
<!-- The community page: header (title, notifications, profile), instant search, kind chips, Popular/Recent/Following
     tabs, the feed, and Explore/Saved/Profile at the bottom with a floating Publish button. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/evolve_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/evolve_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/evolve_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/evolve_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/evolve_back"
                android:src="@drawable/ic_evolve_back"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/evolve_page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/evolve_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:ignore="UnusedAttribute" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/evolve_notifications"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/evolve_notifications"
                    android:src="@drawable/ic_mtrl_notifications"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/evolve_notifications_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/evolve_badge_dot"
                    android:gravity="center"
                    android:minWidth="16dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/evolve_on_accent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="3"
                    tools:visibility="visible" />
            </FrameLayout>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/evolve_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/evolve_nav_profile"
                android:src="@drawable/ic_evolve_person"
                app:civ_border_color="@color/evolve_stroke"
                app:civ_border_width="1dp" />
        </LinearLayout>

        <!-- Instant search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/evolve_search_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mtrl_search"
                app:tint="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/evolve_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/evolve_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/evolve_search_clear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/evolve_search_clear"
                android:src="@drawable/ic_mtrl_close"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Kind filters -->
        <HorizontalScrollView
            android:id="@+id/evolve_kinds_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/evolve_kinds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/evolve_tabs"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/evolve_accent"
            app:tabIndicatorFullWidth="false"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/evolve_accent"
            app:tabTextColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/evolve_offline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/evolve_warning_bg"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/evolve_offline"
            android:textColor="@color/evolve_warning"
            android:textSize="12sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/evolve_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/evolve_feed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="88dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/evolve_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp"
                android:visibility="gone">

                <include layout="@layout/evolve_skeleton_item" />

                <include layout="@layout/evolve_skeleton_item" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/evolve_state_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/evolve_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    tools:text="Nothing here yet" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/evolve_retry"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/evolve_retry"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/evolve_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/evolve_card"
            app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/evolve_bottom_nav" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/evolve_publish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:text="@string/evolve_publish"
        app:backgroundTint="@color/evolve_accent"
        app:icon="@drawable/ic_mtrl_add"
        app:iconTint="@color/evolve_on_accent"
        android:textColor="@color/evolve_on_accent" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
