<?xml version="1.0" encoding="utf-8"?>
<!-- One post of the community feed: author line, title, description, tags, a screenshot or the code, and the actions. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/evolve_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/evolve_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <!-- Author line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/post_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_evolve_person"
                app:civ_border_color="@color/evolve_stroke"
                app:civ_border_width="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/post_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Aziz" />

                <TextView
                    android:id="@+id/post_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="Oct 15, 2026 · v1.2" />
            </LinearLayout>

            <TextView
                android:id="@+id/post_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/evolve_badge_bg"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/evolve_badge_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Java" />

            <ImageButton
                android:id="@+id/post_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/evolve_more"
                android:src="@drawable/ic_mtrl_more_vertical"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/post_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="UnusedAttribute"
            tools:text="Login helper with retry" />

        <TextView
            android:id="@+id/post_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="Wraps the sign-in call, retries on network errors and reports the failure." />

        <pro.sketchware.evolve.TagRow
            android:id="@+id/post_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- First screenshot, when the post has one -->
        <ImageView
            android:id="@+id/post_screenshot"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/evolve_preview_bg"
            android:contentDescription="@string/evolve_screenshot_description"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- The code, highlighted: the start of it -->
        <TextView
            android:id="@+id/post_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/evolve_preview_bg"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="7"
            android:padding="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="public class LoginHelper {\n    void signIn() {}\n}" />

        <!-- Blocks drawn like the drawer draws them -->
        <pro.sketchware.evolve.PreviewFrame
            android:id="@+id/post_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/evolve_preview_bg"
            android:padding="8dp"
            android:visibility="gone" />

        <!-- What the post needs and risks -->
        <TextView
            android:id="@+id/post_notice"
            style="@style/EvolveCardNotice"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:drawableStartCompat="@drawable/ic_evolve_flag"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            tools:text="Needs Android 8 (API 26) or newer"
            tools:visibility="visible" />

        <!-- Actions and counters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_like"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                app:icon="@drawable/ic_evolve_favorite_border"
                app:iconPadding="4dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                tools:text="12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_comments"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                app:icon="@drawable/ic_evolve_comment"
                app:iconPadding="4dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                tools:text="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_save"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="@string/evolve_save"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                app:icon="@drawable/ic_evolve_bookmark_border"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/post_downloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                tools:text="1,204 downloads" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
