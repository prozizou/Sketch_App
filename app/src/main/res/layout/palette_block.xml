<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/palette_sheet_bg"
    android:clipToOutline="true"
    android:elevation="8dp"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/palette_handle_bg" />

    <!-- Hidden until the search icon is tapped, to leave the space to the blocks. -->
    <EditText
        android:id="@+id/search_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/palette_search_bg"
        android:drawableStart="@drawable/ic_search_palette"
        android:drawablePadding="8dp"
        android:hint="@string/search_header"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/palette_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Opens the search field above; becomes a close button while it is open. -->
        <ImageView
            android:id="@+id/search_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_header"
            android:padding="9dp"
            android:src="@drawable/ic_search_palette"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.besome.sketch.editor.logic.PaletteSelector
            android:id="@+id/palette_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="8dp"
            android:paddingVertical="6dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <com.besome.sketch.lib.ui.CustomScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Action buttons share rows (wrapping when they don't fit) instead of one full-width row each. -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/actions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp"
                app:flexWrap="wrap" />

            <com.besome.sketch.lib.ui.CustomHorizontalScrollView
                android:id="@+id/scroll_horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/block_builder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp" />
            </com.besome.sketch.lib.ui.CustomHorizontalScrollView>
        </LinearLayout>
    </com.besome.sketch.lib.ui.CustomScrollView>
</LinearLayout>
